{
  "name": "luch-browser",
  "productName": "Luch",
  "version": "0.1.0",
  "description": "Минималистичный браузер на движке Chromium",
  "license": "GPL-3.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node tests/e2e.mjs",
    "build:adblocker": "esbuild chromium/build/adblocker-entry.js --bundle --minify --format=iife --platform=browser --outfile=chromium/extension/ui/adblocker.js",
    "build:importer": "swiftc -O -o chromium/native/luch-importer chromium/native/importer.swift"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "esbuild": "0.25.10"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0"
  }
}
